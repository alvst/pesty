<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.application-identifier</key>
    <string>H3WXHVTP97.com.greycorelabs.pesty</string>
    <key>com.apple.developer.team-identifier</key>
    <string>H3WXHVTP97</string>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- The Privacy tab picks apps to exclude from history with an NSOpenPanel.
         Without this the sandbox hands back a URL the app cannot read, and any app
         outside /Applications silently fails to be added. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.greycorelabs.pesty</string>
    </array>
    <key>com.apple.developer.icloud-container-environment</key>
    <string>Production</string>
    <key>com.apple.developer.aps-environment</key>
    <string>production</string>
</dict>
</plist>
