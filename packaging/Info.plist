<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Pesty</string>
    <key>CFBundleDisplayName</key>
    <string>Pesty</string>
    <key>CFBundleIdentifier</key>
    <string>com.alvst.pesty</string>
    <key>CFBundleExecutable</key>
    <string>Pesty</string>
    <key>CFBundleIconFile</key>
    <string>Pesty</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD__</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Free and open source under the MIT License.</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- The in-process drag marker must be a declared UTType: conformance
         matching for .onDrop/hasItemsConforming silently fails for
         undeclared custom identifiers, which reads as "drops just don't
         land" with no error anywhere. UTType(exportedAs:) covered the old
         NSItemProvider path in-process, but the native dragging session
         writes NSPasteboardItems, whose type matching goes through the
         declared-types database. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.alvst.pesty.clip-id</string>
            <key>UTTypeDescription</key>
            <string>Pesty Clip Identifier</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
